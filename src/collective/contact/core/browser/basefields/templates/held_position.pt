<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      xml:lang="en"
      tal:define="
        icons python:context.restrictedTraverse('@@iconresolver');
        ajax_load request/ajax_load | nothing;
      "
      i18n:domain="collective.contact.core"
>
  <div class="actions"
       tal:condition="view/can_edit"
  >
    <a class="edit-hp pat-plone-modal"
       title="Edit"
       data-pat-plone-modal='{"actionOptions": {"displayInModal": false}}'
       tal:attributes="
         href string:${context/absolute_url}/edit;
       "
       i18n:attributes="title"
       i18n:domain="plone"
    >
      <tal:icon tal:replace="structure python:icons.tag('pencil-fill')" />
    </a>
  </div>


  <h1 class="heldpos">
    <tal:icon tal:define="
                icon_name string:contenttype/${context/portal_type};
              "
              tal:replace="structure python:icons.tag(icon_name)"
    />
    <span tal:content="view/title"></span>
  </h1>

  <div id="viewlet-below-content-title"
       tal:condition="python: view.display_below_content_title() and not ajax_load"
       tal:content="structure provider:plone.belowcontenttitle"
  ></div>

  <div class="field"
       tal:condition="context/photo"
  >
    <label tal:condition="view/display_photo_label"><tal:block i18n:translate="">Photo</tal:block>:</label>
    <img tal:replace="structure context/@@images/photo/thumb" />
  </div>

  <div class="field"
       tal:condition="view/position"
  >
    <label><tal:block i18n:translate="">Position</tal:block>:</label>
    <tal:icon tal:define="
                icon_name string:contenttype/${view/position/portal_type};
              "
              tal:replace="structure python:icons.tag(icon_name)"
    />
    <a class="link-tooltip"
       tal:attributes="
         href view/position/absolute_url;
         data-base_url view/position/absolute_url;
       "
    >
      <span tal:content="view/position/Title"
            i18n:translate=""
      ></span>
    </a>
  </div>

  <div class="field"
       tal:condition="view/start_date"
  >
    <label><tal:block i18n:translate="">Start date</tal:block>:</label>
    <span tal:content="view/start_date"
          i18n:translate=""
    ></span>
  </div>

  <div class="field"
       tal:condition="view/end_date"
  >
    <label><tal:block i18n:translate="">End date</tal:block>:</label>
    <span tal:content="view/end_date"
          i18n:translate=""
    ></span>
  </div>

</html>
