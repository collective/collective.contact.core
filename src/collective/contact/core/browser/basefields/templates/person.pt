<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      tal:define="
        icons python:context.restrictedTraverse('@@iconresolver');
        portal_url context/@@plone_portal_state/portal_url;
        ajax_load request/ajax_load | nothing;
      "
      tal:omit-tag=""
      i18n:domain="collective.contact.core"
>

  <div class="actions"
       tal:condition="view/can_edit"
  >
    <a class="edit-person pat-plone-modal"
       title="Edit"
       data-pat-plone-modal='{"actionOptions": {"displayInModal": false}}'
       tal:attributes="
         href string:${context/absolute_url}/edit;
       "
       i18n:attributes="title"
       i18n:domain="plone"
    >
      <tal:icon tal:replace="structure python:icons.tag('pencil-fill')" />
    </a>
  </div>
  <h1 class="fn">
    <tal:icon tal:define="
                icon_name string:contenttype/${context/portal_type};
              "
              tal:replace="structure python:icons.tag(icon_name)"
    />
    <span tal:content="view/name"></span>
  </h1>

  <div id="viewlet-below-content-title"
       tal:condition="python: view.display_below_content_title() and not ajax_load"
       tal:content="structure provider:plone.belowcontenttitle"
  ></div>

  <div class="field"
       id="photo"
       tal:condition="context/photo"
  >
    <label tal:condition="view/display_photo_label"><tal:block i18n:translate="">Photo</tal:block>:</label>
    <img tal:define="
           scales nocall:context/@@images;
         "
         tal:replace="structure python:scales.tag('photo', 'thumb', css_class='photo')"
         tal:on-error="string:Bad photo format"
    />
  </div>

  <div class="field"
       id="birthday"
       tal:condition="view/birthday"
  >
    <label><tal:block i18n:translate="">Birthday</tal:block>:</label>
    <span class="bday"
          tal:content="view/birthday"
          i18n:translate=""
    ></span>
  </div>

  <div class="field"
       id="signature"
       tal:condition="context/signature"
  >
    <label><tal:block i18n:translate="">Signature</tal:block>:</label>
    <img tal:define="
           scales nocall:context/@@images;
         "
         tal:replace="structure python:scales.tag('signature', 'mini', css_class='signature')"
         tal:on-error="string:Bad signature format"
    />
  </div>

</html>
