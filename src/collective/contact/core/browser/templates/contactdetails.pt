<div xmlns="http://www.w3.org/1999/xhtml"
     xmlns:i18n="http://xml.zope.org/namespaces/i18n"
     xmlns:metal="http://xml.zope.org/namespaces/metal"
     xmlns:tal="http://xml.zope.org/namespaces/tal"
     class="contact-details"
     lang="en"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
       portal_url context/@@plone_portal_state/portal_url;
     "
     i18n:domain="collective.contact.core"
>

  <p class="field"
     id="email"
     tal:condition="view/contact_details/email"
  >
    <label><tal:block i18n:translate="">Email</tal:block>:</label>
    <a class="email"
       tal:content="view/contact_details/email"
       tal:attributes="
         href string:mailto:${view/contact_details/email};
       "
       i18n:translate=""
    ></a>
  </p>

  <p class="field"
     id="phone"
     tal:condition="view/contact_details/phone"
  >
    <label><tal:block i18n:translate="">Phone number</tal:block>:</label>
    <a tal:attributes="
         href string:tel:${view/contact_details/phone};
       ">
      <span class="tel"
            tal:content="view/contact_details/phone"
            i18n:translate=""
      ></span>
    </a>
  </p>

  <p class="field"
     id="cell_phone"
     tal:condition="view/contact_details/cell_phone"
  >
    <label><tal:block i18n:translate="">Cell phone number</tal:block>:</label>
    <span class="tel"
          tal:content="view/contact_details/cell_phone"
          i18n:translate=""
    ></span>
  </p>

  <p class="field"
     id="fax"
     tal:condition="view/contact_details/fax"
  >
    <label><tal:block i18n:translate="">Fax number</tal:block>:</label>
    <span class="tel"
          tal:content="view/contact_details/fax"
          i18n:translate=""
    ></span>
  </p>

  <p class="field"
     id="im_handle"
     tal:condition="view/contact_details/im_handle"
  >
    <label><tal:block i18n:translate="">IM handle</tal:block>:</label>
    <span tal:content="view/contact_details/im_handle"
          i18n:translate=""
    ></span>
  </p>

  <p class="field"
     id="website"
     tal:define="
       website view/contact_details/website;
     "
     tal:condition="view/contact_details/website"
  >
    <label><tal:block i18n:translate="">Website</tal:block>:</label>
    <a class="url"
       target="_new"
       tal:content="website"
       tal:attributes="
         href website;
       "
    ></a>
  </p>

  <p id="address"
     tal:replace="structure view/render_address"
  ></p>

  <p id="download_vcard"
     tal:condition="view/contact_details"
  >
    <a href="@@contact.vcf"
       tal:attributes="
         href string: ${context/absolute_url}/@@contact.vcf;
       "
    >
      <tal:icon tal:replace="structure python:icons.tag('person-vcard')" />
      <tal:vcard i18n:translate="">Download VCard</tal:vcard>
    </a>
  </p>

</div>
