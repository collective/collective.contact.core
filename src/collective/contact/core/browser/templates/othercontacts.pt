<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      tal:define="
        icons python:context.restrictedTraverse('@@iconresolver');
        portal_url context/@@plone_portal_state/portal_url;
      "
      tal:omit-tag=""
      i18n:domain="collective.contact.core"
>

  <div id="other-contacts"
       tal:condition="view/othercontacts"
  >
    <h3 i18n:translate="">Other contacts in this organization:</h3>

    <tal:block tal:repeat="contact view/othercontacts">
      <div class="contact">
        <a tal:define="
             title contact/title;
           "
           tal:attributes="
             href contact/person/absolute_url;
           "
        >
          <span class="contact-photo"
                tal:condition="contact/display_photo"
          >
            <img tal:condition="contact/has_photo"
                 tal:replace="structure contact/obj/@@images/photo/tile|string:X"
            />
            <img height="64"
                 src="++resource++collective.contact.core/defaultUser.png"
                 style="border: none"
                 tal:condition="not:contact/has_photo"
            />
          </span>
          <img tal:define="
                 icon_name string:contenttype/${contact/person/portal_type};
               "
               tal:condition="not:contact/display_photo"
               tal:replace="structure python:icons.tag(icon_name)"
          />

          <span class="contact-title"
                tal:content="title"
          ></span>
        </a>

        <a tal:attributes="
             href contact/obj/absolute_url;
           ">
          <img tal:define="
                 icon_name string:contenttype/${contact/obj/portal_type};
               "
               tal:replace="structure python:icons.tag(icon_name)"
          />
          <span id="contact-held-position"
                tal:condition="contact/held_position"
                tal:content="contact/held_position"
          ></span>
        </a>

        <span id="contact-phone"
              tal:condition="contact/phone"
              tal:content="contact/phone"
        ></span>
        <span id="contact-cellphone"
              tal:condition="contact/cell_phone"
              tal:content="contact/cell_phone"
        ></span>
        <span id="contact-fax"
              tal:condition="contact/fax"
              tal:content="contact/fax"
        ></span>
        <a id="contact-email"
           tal:condition="contact/email"
           tal:content="contact/email"
           tal:attributes="
             href string:mailto:${contact/email};
           "
        ></a>
        <span id="contact-im_handle"
              tal:condition="contact/im_handle"
              tal:content="contact/im_handle"
        ></span>
        <a id="contact-website"
           tal:condition="contact/website"
           tal:content="contact/website"
           tal:attributes="
             href contact/website;
           "
        ></a>
      </div>
    </tal:block>
  </div>

</html>
