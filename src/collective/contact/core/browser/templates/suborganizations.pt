<div xmlns="http://www.w3.org/1999/xhtml"
     xmlns:i18n="http://xml.zope.org/namespaces/i18n"
     xmlns:metal="http://xml.zope.org/namespaces/metal"
     xmlns:tal="http://xml.zope.org/namespaces/tal"
     lang="en"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
       portal_url context/@@plone_portal_state/portal_url;
     "
     i18n:domain="collective.contact.core"
>

  <div class="field"
       id="sub_organizations"
       tal:condition="view/sub_organizations"
  >
    <h3><tal:block i18n:translate="">Organizations in this organization</tal:block>:</h3>
    <ul>
      <tal:block tal:repeat="sub_org view/sub_organizations">
        <li>
          <tal:icon tal:define="
                      icon_name string:contenttype/${context/portal_type};
                    "
                    tal:replace="structure python:icons.tag(icon_name)"
          />
          <a class="link-tooltip"
             tal:attributes="
               href sub_org/getURL;
               data-base_url sub_org/getURL;
             "
          >
            <span tal:replace="sub_org/Title"
                  i18n:translate=""
            ></span>
          </a></li>
      </tal:block>
    </ul>
  </div>
</div>
