<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.contact.core"
    >

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="PositionTypes"
      component=".vocabularies.PositionTypesFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="OrganizationTypesOrLevels"
      component=".vocabularies.OrganizationTypesOrLevelsFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="Genders"
      component=".vocabularies.GendersFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="collective.contact.core.audit_types"
      component=".vocabularies.AuditTypesFactory"
      />

</configure>
